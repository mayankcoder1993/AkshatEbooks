{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarvagyanakoshah.example/schemas/edition-manifest.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "bookId",
    "id",
    "label",
    "contentVersion",
    "publicationYear",
    "status",
    "verifiedThrough",
    "outputDir",
    "outputs",
    "chapters"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^edition-[0-9]{2}$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publicationYear": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2200
    },
    "status": {
      "enum": [
        "planned",
        "drafting",
        "review",
        "ready",
        "published",
        "superseded",
        "archived"
      ]
    },
    "technology": {
      "type": "string"
    },
    "curriculumVersion": {
      "type": "string"
    },
    "examCycle": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "verifiedThrough": {
      "type": "string",
      "format": "date"
    },
    "contentModule": {
      "type": "string",
      "pattern": "^editions/"
    },
    "outputDir": {
      "type": "string",
      "pattern": "^public/books/"
    },
    "outputs": {
      "type": "object",
      "required": [
        "docx",
        "offlineHtml"
      ],
      "additionalProperties": false,
      "properties": {
        "docx": {
          "type": "string",
          "pattern": "\\.docx$"
        },
        "offlineHtml": {
          "type": "string",
          "pattern": "\\.html$"
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "subtitle"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          }
        }
      }
    }
  }
}
