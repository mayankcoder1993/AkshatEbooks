{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarvagyanakoshah.example/schemas/release-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "bookId", "editionId", "contentVersion", "commit", "releasedAt", "verifiedThrough", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "bookId": { "type": "string" },
    "editionId": { "type": "string" },
    "contentVersion": { "type": "string" },
    "commit": { "type": "string" },
    "releasedAt": { "type": "string", "format": "date-time" },
    "verifiedThrough": { "type": "string", "format": "date" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "filename", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "format": { "enum": ["docx", "offlineHtml", "pdf"] },
          "filename": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
