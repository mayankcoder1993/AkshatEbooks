{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["book_name", "isbn", "aisle", "author"],
  "properties": {
    "book_name": { "type": "string" },
    "isbn": { "type": "string", "minLength": 3 },
    "aisle": { "type": "integer", "minimum": 1 },
    "author": { "type": "string" }
  }
}
